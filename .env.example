# Copy this file to .env.local, set values locally, and keep .env.local untracked.
# Never put production credentials, real bank details, or customer data in this file.

# Local PostgreSQL for Docker Compose.
POSTGRES_USER=pcc
POSTGRES_PASSWORD=
POSTGRES_PORT=5438
DATABASE_URL=
# Integration tests only. The database name must end with _test: it is wiped on every run.
TEST_DATABASE_URL=

# API settings.
NODE_ENV=development
APP_ENV=development
PORT=4000
TRUST_PROXY=false
WEB_ORIGIN=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CARD_PAYMENT_ENABLED=false
PROXY_SECRET=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
LOG_LEVEL=info

# Payment stays disabled until real account details are configured securely.
BANK_ACCOUNT_HOLDER=
BANK_IBAN=
BANK_BIC=
BANK_NAME=

# Private Cloudflare R2 storage. Credentials belong in the host's secret manager.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
UPLOAD_MAX_BYTES=10485760
PROOF_RETENTION_DAYS=400

# Transactional email is logged locally until a real provider is configured.
EMAIL_PROVIDER=console
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=
ORDER_NOTIFICATION_EMAIL=

# Optional initial administrator. Remove these after the first successful seed.
ADMIN_EMAIL=
ADMIN_PASSWORD=
